# Database Configuration (Neon Postgres Serverless)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/unicompass?sslmode=require"

# Optional Failover Database (Prisma Accelerate)
ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=your_accelerate_key"

# Authentication (BetterAuth)
BETTER_AUTH_SECRET="unicompass_development_secret_key_32bytes_minimum!"
BETTER_AUTH_URL="http://localhost:3000"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
